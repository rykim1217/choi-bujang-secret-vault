# 비밀 없는 학생 런타임 설정 예시입니다.
ON_PORT=5189
# 기본 예시는 연결 어댑터를 지정하지 않습니다. 따라서 demo 또는 연결 끊김 상태로 시작합니다.
# 실제 연결을 사용할 때만 담당자가 제공한 어댑터 파일의 절대 경로를 지정합니다.
ON_ENGINE_ADAPTER=
# AI 모델도 원격 앱 정책의 허용 목록을 확인해야 합니다.
ON_AI_MODEL=aleph/auto
# 실제 앱 신원 매핑/연결/보관함은 신뢰된 호스트가 구성합니다. 기본 비활성화입니다.
# OSV는 공개 조회 승인 목록이 비어 있으면 외부 조회하지 않습니다.
ON_PROJECT_DIRECTORY=
ON_APPROVED_PUBLIC_PACKAGES=[]
